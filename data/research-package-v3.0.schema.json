{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sankhipkate.github.io/immigration-country-matcher/data/research-package-v3.0.schema.json",
  "title": "MVP Research Package 3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "research_template",
    "country_id",
    "country_name_ru",
    "country_name_en",
    "research_date",
    "next_review_date",
    "status_policy",
    "country_summary_ru",
    "routes",
    "cities",
    "schools",
    "pets",
    "lgbt",
    "glossary",
    "excluded_from_research",
    "open_items",
    "completeness",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "research_template": {
      "const": "MVP Research Template 3.0"
    },
    "country_id": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "country_name_ru": {
      "type": "string",
      "minLength": 1
    },
    "country_name_en": {
      "type": "string",
      "minLength": 1
    },
    "research_date": {
      "type": "string",
      "format": "date"
    },
    "next_review_date": {
      "type": "string",
      "format": "date"
    },
    "status_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statuses",
        "principle_ru"
      ],
      "properties": {
        "statuses": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "prefixItems": [
            {
              "const": "SUITABLE"
            },
            {
              "const": "SUITABLE_WITH_CONDITIONS"
            },
            {
              "const": "UNSUITABLE"
            }
          ],
          "items": false
        },
        "principle_ru": {
          "type": "string",
          "minLength": 1,
          "description": "Обязательно: доход ниже порога = UNSUITABLE; процедурные требования (место подачи, поездка, счёт, выписки за период, апостиль, легализация, перевод) не понижают статус; история дохода и срок договора калькулятором не проверяются."
        }
      }
    },
    "country_summary_ru": {
      "type": "string",
      "minLength": 1
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "cities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/city"
      }
    },
    "schools": {
      "$ref": "#/$defs/schools"
    },
    "pets": {
      "$ref": "#/$defs/pets"
    },
    "lgbt": {
      "$ref": "#/$defs/lgbt"
    },
    "glossary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/glossaryItem"
      }
    },
    "excluded_from_research": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "open_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openItem"
      }
    },
    "completeness": {
      "$ref": "#/$defs/completeness"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "entry_for_russian_citizen": {
      "$ref": "#/$defs/entryForRussianCitizen"
    },
    "research_quality": {
      "$ref": "#/$defs/researchQuality"
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publishable",
        "available_to_russian_citizen",
        "renewal_available",
        "income_threshold_amount",
        "income_threshold_currency",
        "income_formula",
        "income_documentation_required",
        "local_work_allowed",
        "remote_foreign_work_allowed",
        "business_allowed",
        "open_questions",
        "route_id",
        "name_ru",
        "official_term_ru",
        "route_type",
        "basis_ru",
        "application_inside_ru",
        "application_abroad_ru",
        "first_permit_months",
        "renewal_months",
        "income_rule_ru",
        "income_threshold_type",
        "family_rule_ru",
        "partner_work_rights_ru",
        "pr_path_ru",
        "citizenship_path_ru",
        "presence_rule_ru",
        "dual_citizenship_ru",
        "status_logic_ru",
        "source_ids"
      ],
      "properties": {
        "publishable": {
          "type": "boolean"
        },
        "available_to_russian_citizen": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "renewal_available": {
          "type": "boolean"
        },
        "income_threshold_amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "income_threshold_currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "income_formula": {
          "type": [
            "string",
            "null"
          ]
        },
        "income_documentation_required": {
          "type": "boolean"
        },
        "local_work_allowed": {
          "type": "boolean"
        },
        "remote_foreign_work_allowed": {
          "type": "boolean"
        },
        "business_allowed": {
          "type": "boolean"
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "route_id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "name_ru": {
          "type": "string",
          "minLength": 1
        },
        "official_term_ru": {
          "type": "string",
          "minLength": 1
        },
        "route_type": {
          "type": "string",
          "minLength": 1
        },
        "basis_ru": {
          "type": "string",
          "minLength": 1
        },
        "application_inside_ru": {
          "type": "string",
          "minLength": 1
        },
        "application_abroad_ru": {
          "type": "string",
          "minLength": 1
        },
        "first_permit_months": {
          "type": "integer",
          "minimum": 0
        },
        "renewal_months": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "income_rule_ru": {
          "type": "string",
          "minLength": 1
        },
        "income_threshold_type": {
          "type": "string",
          "minLength": 1
        },
        "family_rule_ru": {
          "type": "string",
          "minLength": 1
        },
        "partner_work_rights_ru": {
          "type": "string",
          "minLength": 1
        },
        "pr_path_ru": {
          "type": "string",
          "minLength": 1
        },
        "citizenship_path_ru": {
          "type": "string",
          "minLength": 1
        },
        "presence_rule_ru": {
          "type": "string",
          "minLength": 1
        },
        "dual_citizenship_ru": {
          "type": "string",
          "minLength": 1
        },
        "status_logic_ru": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "long_term_path": {
          "$ref": "#/$defs/longTermPath"
        }
      }
    },
    "city": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "city_id",
        "name_ru",
        "roles_ru",
        "size",
        "population_reference",
        "budget_single_usd",
        "budget_couple_usd",
        "budget_family_1_child_usd",
        "rent_1br_center_usd",
        "cost_scope_ru",
        "climate_category_ru",
        "cold_period_temperature_range_c",
        "hot_period_temperature_range_c",
        "lgbt_safety_ru",
        "public_school_available",
        "public_school_language",
        "international_school_status_ru",
        "international_school_cost_ru",
        "source_ids",
        "confidence"
      ],
      "properties": {
        "city_id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "name_ru": {
          "type": "string",
          "minLength": 1
        },
        "roles_ru": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "size": {
          "enum": [
            "крупный",
            "средний",
            "небольшой"
          ]
        },
        "population_reference": {
          "type": "string",
          "minLength": 1
        },
        "budget_single_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "budget_couple_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "budget_family_1_child_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rent_1br_center_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cost_scope_ru": {
          "type": "string",
          "minLength": 1
        },
        "climate_category_ru": {
          "type": "string",
          "minLength": 1
        },
        "cold_period_temperature_range_c": {
          "type": "string",
          "minLength": 1
        },
        "hot_period_temperature_range_c": {
          "type": "string",
          "minLength": 1
        },
        "lgbt_safety_ru": {
          "type": "string",
          "minLength": 1
        },
        "public_school_available": {
          "type": "boolean"
        },
        "public_school_language": {
          "type": "string",
          "minLength": 1
        },
        "international_school_status_ru": {
          "type": "string",
          "minLength": 1
        },
        "international_school_cost_ru": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "confidence": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        }
      }
    },
    "schools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_school_ru",
        "public_school_cost",
        "international_school_ru",
        "budget_rule_ru",
        "source_ids"
      ],
      "properties": {
        "public_school_ru": {
          "type": "string",
          "minLength": 1
        },
        "public_school_cost": {
          "type": "number",
          "minimum": 0
        },
        "international_school_ru": {
          "type": "string",
          "minLength": 1
        },
        "budget_rule_ru": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "pets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dogs_import_allowed",
        "cats_import_allowed",
        "national_breed_ban_found",
        "breed_rule_ru",
        "routine_quarantine_required",
        "quarantine_days",
        "prior_import_permit_required_for_accompanied_pet",
        "result_text_ru",
        "source_ids"
      ],
      "properties": {
        "dogs_import_allowed": {
          "type": "boolean"
        },
        "cats_import_allowed": {
          "type": "boolean"
        },
        "national_breed_ban_found": {
          "type": "boolean"
        },
        "breed_rule_ru": {
          "type": "string",
          "minLength": 1
        },
        "routine_quarantine_required": {
          "type": "boolean"
        },
        "quarantine_days": {
          "type": "integer",
          "minimum": 0
        },
        "prior_import_permit_required_for_accompanied_pet": {
          "type": "boolean"
        },
        "result_text_ru": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "lgbt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_sex_marriage_recognized",
        "same_sex_marriage_rule_ru",
        "registered_partnership_recognized",
        "registered_partnership_translation_ru",
        "registered_partnership_rule_ru",
        "family_route_available",
        "foreign_documents_recognized",
        "foreign_document_rule_ru",
        "country_safety_category_ru",
        "safety_explanation_ru",
        "international_protection_ru",
        "source_ids"
      ],
      "properties": {
        "same_sex_marriage_recognized": {
          "type": "boolean"
        },
        "same_sex_marriage_rule_ru": {
          "type": "string",
          "minLength": 1
        },
        "registered_partnership_recognized": {
          "type": "boolean"
        },
        "registered_partnership_translation_ru": {
          "type": "string",
          "minLength": 1
        },
        "registered_partnership_rule_ru": {
          "type": "string",
          "minLength": 1
        },
        "family_route_available": {
          "type": "boolean"
        },
        "foreign_documents_recognized": {
          "type": "boolean"
        },
        "foreign_document_rule_ru": {
          "type": "string",
          "minLength": 1
        },
        "country_safety_category_ru": {
          "enum": [
            "безопасно",
            "достаточно безопасно",
            "средне",
            "небезопасно"
          ]
        },
        "safety_explanation_ru": {
          "type": "string",
          "minLength": 1
        },
        "international_protection_ru": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "pending_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pendingChange"
          }
        }
      }
    },
    "glossaryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "translation_ru",
        "explanation_ru"
      ],
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1
        },
        "translation_ru": {
          "type": "string",
          "minLength": 1
        },
        "explanation_ru": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "openItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "priority",
        "blocks_ru",
        "missing_ru",
        "handling_ru"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "priority": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "blocks_ru": {
          "type": "string",
          "minLength": 1
        },
        "missing_ru": {
          "type": "string",
          "minLength": 1
        },
        "handling_ru": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "authority",
        "title_ru",
        "url",
        "supports_ru",
        "checked_at",
        "confidence"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "title_ru": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "supports_ru": {
          "type": "string",
          "minLength": 1
        },
        "checked_at": {
          "type": "string",
          "format": "date"
        },
        "confidence": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_percent",
        "public_routes_ready",
        "hidden_routes",
        "country_ready_status",
        "country_ready_status_ru",
        "blocks",
        "publication_blockers",
        "non_blocking_gaps"
      ],
      "properties": {
        "overall_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "public_routes_ready": {
          "type": "integer",
          "minimum": 0
        },
        "hidden_routes": {
          "type": "integer",
          "minimum": 0
        },
        "country_ready_status": {
          "type": "string",
          "minLength": 1
        },
        "country_ready_status_ru": {
          "type": "string",
          "minLength": 1
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "block",
              "percent",
              "missing_ru"
            ],
            "properties": {
              "block": {
                "type": "string",
                "minLength": 1
              },
              "percent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "missing_ru": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "publication_blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "non_blocking_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pendingChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id",
        "status",
        "title_ru",
        "summary_ru",
        "expected_effective_date",
        "impact_ru",
        "source_ids"
      ],
      "properties": {
        "change_id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "status": {
          "enum": [
            "BILL_UNDER_CONSIDERATION",
            "ADOPTED_NOT_IN_FORCE",
            "OFFICIALLY_ANNOUNCED"
          ]
        },
        "title_ru": {
          "type": "string",
          "minLength": 1
        },
        "summary_ru": {
          "type": "string",
          "minLength": 1
        },
        "expected_effective_date": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "impact_ru": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "entryForRussianCitizen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_ru",
        "primary_method",
        "air_entry_ru",
        "land_sea_entry_ru",
        "fee_local_ru",
        "fee_usd",
        "processing_time_ru",
        "authorization_validity_days",
        "maximum_stay_days",
        "entries",
        "entry_guaranteed",
        "in_country_residence_application_ru",
        "source_ids"
      ],
      "properties": {
        "summary_ru": {
          "type": "string",
          "minLength": 1
        },
        "primary_method": {
          "type": "string",
          "minLength": 1
        },
        "air_entry_ru": {
          "type": "string",
          "minLength": 1
        },
        "land_sea_entry_ru": {
          "type": "string",
          "minLength": 1
        },
        "fee_local_ru": {
          "type": "string",
          "minLength": 1
        },
        "fee_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "processing_time_ru": {
          "type": "string",
          "minLength": 1
        },
        "authorization_validity_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maximum_stay_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "entries": {
          "type": "string",
          "minLength": 1
        },
        "entry_guaranteed": {
          "type": "boolean"
        },
        "in_country_residence_application_ru": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "longTermPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_residence_available",
        "renewal_confirmed",
        "direct_pr_conversion",
        "residence_counts_for_pr",
        "alternative_basis_required",
        "residence_counts_for_citizenship",
        "chain_confirmed_for_required_citizenship",
        "explanation_ru"
      ],
      "properties": {
        "initial_residence_available": {
          "type": "boolean"
        },
        "renewal_confirmed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "direct_pr_conversion": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "residence_counts_for_pr": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "alternative_basis_required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "residence_counts_for_citizenship": {
          "type": [
            "boolean",
            "null"
